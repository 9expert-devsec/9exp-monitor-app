# ---------------------------------------------------------------------------
# Required — server-side only. Never expose these to the browser.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Supabase service role key (Project Settings → API → service_role).
# Bypasses RLS. This is the only key that writes.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/checks/run and POST /api/checks/prune.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional — enables live updates on the dashboard.
#
# The anon key is publishable by design: RLS grants it SELECT and nothing else.
# Leave these unset and the dashboard still works, it just will not push
# Realtime updates and only refreshes on navigation or "Check now".
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
