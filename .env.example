# ---------------------------------------------------------------------------
# Required — server-side only. Never expose these to the browser.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Supabase service role key (Project Settings → API → service_role).
# Bypasses RLS. This is the only key that writes.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/checks/run and POST /api/checks/prune.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Required — publishable, sent to the browser.
#
# Sign-in, the session cookies and Realtime all run on these. The anon key is
# publishable by design: RLS lets a signed-in user read monitoring data and
# their own profile row, and anon on its own can read nothing.
# (Project Settings → API → Project URL / anon public key.)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
